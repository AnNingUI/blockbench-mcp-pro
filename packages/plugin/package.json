{
  "name": "@anningui/blockbench-mcp",
  "version": "1.0.3",
  "description": "Blockbench 的 MCP 服务器与插件:95 个工具,插件内进程 HTTP MCP + stdio 网关,建模/程序化细节/贴图/动画/质量门/人审/参考图比对",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "blockbench",
    "minecraft",
    "modeling",
    "texturing",
    "animation",
    "geckolib",
    "ai"
  ],
  "license": "MIT",
  "author": "AnNingUI",
  "type": "module",
  "main": "dist/gateway.mjs",
  "exports": {
    ".": "./dist/gateway.mjs",
    "./plugin": "./dist/blockbench_mcp.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "blockbench-mcp": "bin/blockbench-mcp.mjs"
  },
  "files": [
    "bin",
    "dist/blockbench_mcp.js",
    "dist/gateway.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rolldown -c build/rolldown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p build/tsconfig.json --noEmit",
    "test": "vitest run test/dispatch.test.mjs test/http.test.mjs test/bundle.test.mjs test/card.test.mjs test/package.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "devDependencies": {
    "@bbmcp/shared": "*",
    "@types/node": "^26.5.1",
    "blockbench-types": "^5.1.0",
    "rolldown": "^1.2.8",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnNingUI/blockbench-mcp-pro.git"
  },
  "bugs": {
    "url": "https://github.com/AnNingUI/blockbench-mcp-pro/issues"
  },
  "homepage": "https://github.com/AnNingUI/blockbench-mcp-pro#readme"
}
