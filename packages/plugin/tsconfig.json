{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "blockbench-types"
    ],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "src",
    "types.d.ts"
  ],
  // 构建配置有自己的项目(见 build/tsconfig.json),类型环境是 node 而不是 blockbench-types
  "exclude": [
    "build",
    "dist"
  ]
}
